# formatLongList.awk -- this is a script meant to format the long list output from ls
#

ls -l $*| awk '

BEGIN { print "BYTES", "\t", "FILE" }

NF == 9 && /^-/ {
	sum += $5
        ++filenum
        print $5, "\t", $9

}

NF == 9 && /^d/ {
	print "<dir>", "\t", $9 # print dir and name 
}

$1 ~ /^\..*:$/ {
print "\t" $0 
}



END { print "Total: ", sum, "bytes (" filenum " files)" }
'



